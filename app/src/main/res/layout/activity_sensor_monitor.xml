<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|start" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back" android:src="@drawable/ic_back"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sensor Diagnostics" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_accel_avail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"/>
    <TextView android:id="@+id/tv_accel_values" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for readings"/>
    <TextView android:id="@+id/tv_gyro_avail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/tv_gyro_values" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for readings"/>
    <TextView android:id="@+id/tv_mag_avail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/tv_mag_values" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for readings"/>
    <TextView android:id="@+id/tv_prox_avail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/tv_prox_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for readings"/>
    <TextView android:id="@+id/tv_light_avail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/tv_light_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for readings"/>
</LinearLayout>
</ScrollView>

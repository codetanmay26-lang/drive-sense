<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|start" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back" android:src="@drawable/ic_back"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/sensitivity_label"/>
    <SeekBar android:id="@+id/sb_sensitivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
    <TextView android:id="@+id/tv_sensitivity_value" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/speed_alert_label"/>
    <SeekBar android:id="@+id/sb_speed_threshold" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200"/>
    <TextView android:id="@+id/tv_speed_value" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/fatigue_interval_label"/>
    <SeekBar android:id="@+id/sb_fatigue_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="120"/>
    <TextView android:id="@+id/tv_fatigue_value" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Switch android:id="@+id/sw_auto_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/auto_start_label"/>
    <Switch android:id="@+id/sw_auto_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auto_theme_label"/>
    <Button android:id="@+id/btn_sensor_diagnostic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/sensor_diagnostic_label"/>
</LinearLayout>
</ScrollView>

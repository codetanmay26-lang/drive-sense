<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|start" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back" android:src="@drawable/ic_back"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Driving Events" android:textSize="24sp" android:textStyle="bold" android:layout_margin="8dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_events" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
